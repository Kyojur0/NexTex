# Optional AI. Copy to .env.local and choose one provider configuration.
# AI_GATEWAY_API_KEY=your-gateway-key

# An OpenAI-compatible API. Use the provider's supported model ID in Settings.
# NEXTEX_AI_BASE_URL=http://127.0.0.1:1234/v1
# NEXTEX_AI_API_KEY=your-key-if-required

# When running this frontend directly, set the backend URL before dev/build.
# The root launcher/build scripts configure this automatically.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
